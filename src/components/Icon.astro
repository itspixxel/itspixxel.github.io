---
import { iconPaths, type IconName } from "../icons";
interface Props { name: IconName }
const { name } = Astro.props;
---
<svg class="ui-icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={iconPaths[name]} /></svg>
