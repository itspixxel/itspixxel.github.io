---
import Icon from "../components/Icon.astro";
import play from "../content/settings/play.json";
import PlayFeature from "../components/PlayFeature.astro";
import Layout from "../layouts/Layout.astro";
import { site, url } from "../lib";
---

<Layout title="404">
  <section class="wrap page-heading">
    <p class="eyebrow">{site.labels.outside}</p>
    <h1>{site.labels.notFound}</h1>
    <p>{site.labels.notFoundText}</p>
    {play.enabled && play.playable404 && <PlayFeature kind="jump" />}
    <a class="text-link" href={url("/")}>
      {site.labels.back} <Icon name="northeast" />
    </a>
  </section>
</Layout>
